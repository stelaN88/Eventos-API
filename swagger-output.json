{
  "swagger": "2.0",
  "info": {
    "title": "Minha API",
    "description": "Documentação da API REST",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/registrar": {
      "post": {
        "summary": "Registra um novo usuário",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nome": {
                  "type": "string",
                  "example": "João Silva"
                },
                "email": {
                  "type": "string",
                  "example": "joao@email.com"
                },
                "senha": {
                  "type": "string",
                  "example": "123456"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Usuário registrado com sucesso"
          },
          "400": {
            "description": "Dados inválidos ou usuário já existe"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Realiza login do usuário",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "joao@email.com"
                },
                "senha": {
                  "type": "string",
                  "example": "123456"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login realizado com sucesso, retorna token JWT"
          },
          "401": {
            "description": "Email ou senha inválidos"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Lista todos os eventos",
        "description": "",
        "responses": {
          "200": {
            "description": "Lista de eventos retornada com sucesso"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      },
      "post": {
        "summary": "Cria um novo evento",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nome": {
                  "type": "string",
                  "example": "Show de Rock"
                },
                "descricao": {
                  "type": "string",
                  "example": "Descrição do evento"
                },
                "data": {
                  "type": "string",
                  "example": "2025-12-01"
                },
                "local": {
                  "type": "string",
                  "example": "São Paulo"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Evento criado com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/{id}": {
      "get": {
        "summary": "Busca evento por ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID do evento"
          }
        ],
        "responses": {
          "200": {
            "description": "Evento encontrado com sucesso"
          },
          "404": {
            "description": "Evento não encontrado"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "summary": "Atualiza um evento existente",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID do evento"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nome": {
                  "type": "string",
                  "example": "Show de Rock Atualizado"
                },
                "descricao": {
                  "type": "string",
                  "example": "Nova descrição"
                },
                "data": {
                  "type": "string",
                  "example": "2025-12-10"
                },
                "local": {
                  "type": "string",
                  "example": "Rio de Janeiro"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evento atualizado com sucesso"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Evento não encontrado"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "summary": "Deleta um evento",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID do evento"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Evento deletado com sucesso"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Evento não encontrado"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/{id}/inscrever": {
      "post": {
        "summary": "Inscreve o usuário autenticado em um evento",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID do evento"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Inscrição realizada com sucesso"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Evento não encontrado"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  }
}